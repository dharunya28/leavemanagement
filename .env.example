# ==============================================================
# STUDENT LEAVE MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# Copy this file to .env for local development:
#   cp .env.example .env
# Set these variables in the Render Dashboard under 'Environment'
# ==============================================================

# Port the Express server listens on (Render automatically provides PORT in production)
PORT=5000

# MongoDB Atlas Connection String
# Format: mongodb+srv://<db_username>:<db_password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/student_leave_db?retryWrites=true&w=majority

# Express Session Secret (use a long, random string in production)
SESSION_SECRET=your_long_random_session_secret_key_here

# Initial Staff Credentials (used to automatically seed the admin staff on first launch)
STAFF_NAME=Administrator
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=ChangeMeInProduction123!
